# LLM API Key (required for OpenAI client)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Names (Actor and Critic can share the same model or use distinct ones)
MODEL_NAME=gpt-4o-mini
CRITIC_MODEL_NAME=gpt-4o-mini

# Optional: Alternative OpenAI-compatible base URL (e.g., OpenRouter, Gemini, Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1
