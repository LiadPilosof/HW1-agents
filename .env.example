# LLM API Key (required for OpenAI client)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Name (e.g., gpt-4o-mini, gpt-5.4-mini, gpt-4o)
MODEL_NAME=gpt-4o-mini

# Optional: Alternative OpenAI-compatible base URL (e.g., OpenRouter, Gemini, Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1
