# Copy to .env and fill in. Never commit .env.

# API key for the OpenAI client (required)
OPENAI_API_KEY=your_openai_api_key_here

# Actor model, and Critic model (the Critic falls back to MODEL_NAME if unset)
MODEL_NAME=gpt-4o-mini
CRITIC_MODEL_NAME=gpt-4o-mini

# Optional: an OpenAI-compatible endpoint (e.g. OpenRouter, Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1
